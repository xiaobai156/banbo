>>>>>>         try:
>>>>>>             return RawResponse(
>>>>>>                 final_url=str(response.url),
>>>>>>                 status_code=int(response.status_code),
>>>>>>                 content=bytes(response.content),
>>>>>>                 encoding=response.encoding or response.apparent_encoding,
