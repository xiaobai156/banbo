>>>>>>         candidates = ["utf-8", encoding, "gb18030", "big5"]
>>>>>>         for candidate in candidates:
>>>>>>             if not candidate:
>>>>>>                 continue
>>>>>>             try:
>>>>>>                 return content.decode(candidate)
>>>>>>             except (LookupError, UnicodeDecodeError):
>>>>>>                 continue
>>>>>>         return content.decode("utf-8", errors="replace")
       
