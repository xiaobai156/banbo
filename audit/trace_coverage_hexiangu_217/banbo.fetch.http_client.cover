    2: class RequestsTransport:
    1:     def __init__(self) -> None:
>>>>>>         try:
>>>>>>             import requests
>>>>>>         except ImportError as exc:
>>>>>>             raise RuntimeError("requests not available") from exc
>>>>>>         self._requests = requests
>>>>>>         self._local = local()
