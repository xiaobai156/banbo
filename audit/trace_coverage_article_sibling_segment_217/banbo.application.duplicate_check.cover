    1: from __future__ import annotations
       
    1: from dataclasses import dataclass
    1: from typing import Mapping
       
       
    2: @dataclass(frozen=True)
    1: class DuplicateFinding:
    1:     candidate_name: str
    1:     existing_name: str
    1:     run_length: int
    1:     issues: tuple[int, ...]
    1:     value: str
       
       
    1: def detect_repeats(
           candidate_values: Mapping[int | str, str],
           existing_sites: Mapping[str, Mapping[int | str, str]],
           *,
    1:     minimum_run: int = 3,
    1:     candidate_name: str = "候选站点",
       ) -> tuple[DuplicateFinding, ...]:
>>>>>>     candidate = {int(issue): str(value) for issue, value in candidate_values.items()}
>>>>>>     ordered_issues = sorted(candidate, reverse=True)
>>>>>>     findings: list[DuplicateFinding] = []
>>>>>>     for existing_name, raw_values in existing_sites.items():
>>>>>>         existing = {int(issue): str(value) for issue, value in raw_values.items()}
>>>>>>         run: list[int] = []
>>>>>>         last_issue: int | None = None
>>>>>>         run_values: list[str] = []
>>>>>>         runs: list[tuple[list[int], list[str]]] = []
>>>>>>         for issue in ordered_issues:
>>>>>>             value = candidate[issue]
                   if (
>>>>>>                 issue in existing
>>>>>>                 and existing[issue] == value
>>>>>>                 and last_issue is not None
>>>>>>                 and last_issue - issue == 1
                   ):
>>>>>>                 run.append(issue)
>>>>>>                 run_values.append(value)
                   else:
>>>>>>                 if run:
>>>>>>                     runs.append((run, run_values))
>>>>>>                 matches = issue in existing and existing[issue] == value
>>>>>>                 run = [issue] if matches else []
>>>>>>                 run_values = [value] if matches else []
>>>>>>             last_issue = issue
>>>>>>         if run:
>>>>>>             runs.append((run, run_values))
>>>>>>         for issues, values in runs:
>>>>>>             if len(issues) >= minimum_run:
>>>>>>                 findings.append(
>>>>>>                     DuplicateFinding(
>>>>>>                         candidate_name=candidate_name,
>>>>>>                         existing_name=existing_name,
>>>>>>                         run_length=len(issues),
>>>>>>                         issues=tuple(issues),
>>>>>>                         value="/".join(values),
                           )
                       )
>>>>>>     return tuple(
>>>>>>         sorted(findings, key=lambda item: (-item.run_length, item.existing_name))
           )
