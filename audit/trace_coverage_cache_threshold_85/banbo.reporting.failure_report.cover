    1: from banbo.application.models import SiteRun
    1: from banbo.application.multi_period import MultiPeriodSiteResult
    1: from banbo.storage.atomic_files import commit_files
       
       
    1: _FAILURE_STAGES = {
    1:     FailureCode.NETWORK_ERROR: "网络请求",
    1:     FailureCode.SSL_ERROR: "网络请求",
    1:     FailureCode.HTTP_ERROR: "网络请求",
    1:     FailureCode.TARGET_PERIOD_MISSING: "指定期数校验",
    1:     FailureCode.DIRECTION_MISMATCH: "指定期数校验",
    1:     FailureCode.DIRECTION_WINDOW_INVALID: "指定期数校验",
    1:     FailureCode.ANCHOR_MISSING: "目标定位",
    1:     FailureCode.RECORD_ID_MISMATCH: "目标定位",
