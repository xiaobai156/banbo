    1: from __future__ import annotations
       
    1: import json
    1: from dataclasses import dataclass
    1: from pathlib import Path
    1: from typing import Iterable
       
    1: from banbo.domain import FailureResult, ValidatedResult
    1: from banbo.storage.site_repository import SiteRepository
       
    1: from .single_period import SinglePeriodRunner
       
       
    2: @dataclass(frozen=True)
    1: class RepairCase:
    1:     site_id: str
    1:     issue: int
       
       
    1: def load_repair_cases(path: str | Path, sites: SiteRepository) -> tuple[RepairCase, ...]:
>>>>>>     payload = json.loads(Path(path).read_text(encoding="utf-8-sig"))
>>>>>>     raw_cases = payload.get("cases") if isinstance(payload, dict) else payload
>>>>>>     if not isinstance(raw_cases, list):
>>>>>>         raise ValueError("独立验证清单必须是cases数组")
>>>>>>     cases: list[RepairCase] = []
>>>>>>     seen: set[tuple[str, int]] = set()
>>>>>>     for raw in raw_cases:
>>>>>>         site_id = str(raw.get("site_id", ""))
>>>>>>         issue = int(raw["issue"])
>>>>>>         sites.get(site_id)
>>>>>>         key = (site_id, issue)
>>>>>>         if key in seen:
>>>>>>             raise ValueError(f"独立验证清单存在重复案例：{site_id}/{issue}")
>>>>>>         seen.add(key)
>>>>>>         cases.append(RepairCase(site_id=site_id, issue=issue))
>>>>>>     return tuple(cases)
       
       
    1: def validate_repair_cases(
           cases: Iterable[RepairCase],
           runner: SinglePeriodRunner,
       ) -> list[dict[str, object]]:
>>>>>>     report: list[dict[str, object]] = []
>>>>>>     for case in cases:
>>>>>>         run = runner.run_site(case.site_id, case.issue)
>>>>>>         outcome = run.outcome
>>>>>>         evidence = tuple(outcome.evidence)
>>>>>>         candidate_values = sorted({item.value for item in evidence})
>>>>>>         common_details = {
>>>>>>             "site_id": run.site.site_id,
>>>>>>             "site_name": run.site.name,
>>>>>>             "url": run.site.url,
>>>>>>             "issue": case.issue,
>>>>>>             "direction": run.site.direction.value,
>>>>>>             "document_count": run.document_count,
>>>>>>             "candidate_count": len(evidence),
>>>>>>             "actual_values": candidate_values,
>>>>>>             "top_bottom_correct": all(
>>>>>>                 item.direction == run.site.direction for item in evidence
                   ),
>>>>>>             "anchor_passed": bool(evidence)
>>>>>>             and all(item.anchor_passed for item in evidence),
>>>>>>             "keyword_passed": bool(evidence)
>>>>>>             and all(item.keyword_passed for item in evidence),
>>>>>>             "same_record": bool(evidence)
>>>>>>             and all(item.same_record for item in evidence),
>>>>>>             "conflict_values": sorted(
>>>>>>                 {value for item in evidence for value in item.conflict_values}
                   ),
>>>>>>             "evidence": [
>>>>>>                 {
>>>>>>                     "document_id": item.document_id,
>>>>>>                     "document_source": item.document_source.value,
>>>>>>                     "document_order": item.document_order,
>>>>>>                     "value": item.value,
>>>>>>                     "snippet": item.snippet,
                       }
>>>>>>                 for item in evidence
                   ],
               }
>>>>>>         if isinstance(outcome, ValidatedResult):
>>>>>>             report.append(
>>>>>>                 {
>>>>>>                     **common_details,
>>>>>>                     "passed": True,
>>>>>>                     "value": outcome.value,
                       }
                   )
               else:
>>>>>>             assert isinstance(outcome, FailureResult)
>>>>>>             report.append(
>>>>>>                 {
>>>>>>                     **common_details,
>>>>>>                     "passed": False,
>>>>>>                     "failure_code": outcome.code.value,
>>>>>>                     "failure_reason": outcome.message,
                       }
                   )
>>>>>>     return report
