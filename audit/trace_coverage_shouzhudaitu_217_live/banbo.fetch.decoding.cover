    1: from __future__ import annotations
       
    1: import base64
    1: import re
       
       
    2: _STRDECODE_RE = re.compile(
    1:     r"\bstrdecode\s*\(\s*([\"'])([A-Za-z0-9+/=_-]+)\1\s*\)",
    1:     re.IGNORECASE,
       )
    1: _UNICODE_ESCAPE_RE = re.compile(r"\\u[0-9a-fA-F]{4}")
       
       
    1: def decode_embedded_text(text: str, *, max_depth: int = 3) -> tuple[str, ...]:
   10:     decoded_documents: list[str] = []
   10:     seen = {text}
   10:     pending = [(text, 0)]
  309:     while pending:
  299:         current, depth = pending.pop(0)
  299:         if depth >= max_depth:
>>>>>>             continue
  299:         decoded_now: list[str] = []
  590:         for match in _STRDECODE_RE.finditer(current):
  291:             payload = match.group(2)
  291:             try:
  582:                 raw = base64.b64decode(
  291:                     payload + ("=" * (-len(payload) % 4))
                       )
>>>>>>             except Exception:
>>>>>>                 continue
  291:             for encoding in ("utf-8", "gb18030", "big5"):
  291:                 try:
  291:                     decoded_now.append(raw.decode(encoding))
  291:                     break
>>>>>>                 except UnicodeDecodeError:
>>>>>>                     continue
       
  299:         if _UNICODE_ESCAPE_RE.search(current):
    3:             unescaped = _UNICODE_ESCAPE_RE.sub(
  253:                 lambda match: chr(int(match.group(0)[2:], 16)),
    1:                 current,
    1:             ).replace("\\/", "/")
    1:             if unescaped != current:
    1:                 decoded_now.append(unescaped)
       
  591:         for decoded in decoded_now:
  292:             if not decoded or decoded in seen:
    3:                 continue
  289:             seen.add(decoded)
  289:             decoded_documents.append(decoded)
  289:             pending.append((decoded, depth + 1))
   10:     return tuple(decoded_documents)
