    1:     registry.register_strategy("history_block", HistoryBlockParser)
    1:     registry.register_strategy("nearest_document", NearestDocumentParser)
    1:     registry.register_strategy("scoped_line", ScopedLineParser)
    1:     registry.register_strategy("regex_line", RegexLineParser)
    1:     registry.register_strategy("title_neighbor", TitleNeighborParser)
    1:     registry.register_strategy("split_document", SplitDocumentParser)
    1:     registry.register_strategy("table", TableParser)
    1:     registry.register_strategy("dynamic_api", DynamicApiParser)
    1:     registry.register_strategy("decoded_sibling", DecodedSiblingParser)
