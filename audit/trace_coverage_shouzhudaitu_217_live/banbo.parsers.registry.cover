>>>>>>             enriched.append(
>>>>>>                 replace(
>>>>>>                     item,
>>>>>>                     source_url=document.source_url,
>>>>>>                     parser_id=spec.parser_id or (
>>>>>>                         f"{spec.site_id}:{spec.strategy}:v{spec.parser_version}"
                           ),
>>>>>>                     block_id=f"{document.document_id}:{block_start}:{block_end}",
>>>>>>                     block_start=block_start,
