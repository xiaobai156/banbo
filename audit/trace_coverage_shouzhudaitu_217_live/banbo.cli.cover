  164:     for spec in specs:
  163:         registry.bind(spec)
    1:     return sites, specs, registry
       
       
    1: def _period_from_args(value: int | None) -> int:
>>>>>>     if value is not None:
>>>>>>         if value <= 0:
>>>>>>             raise ValueError("期数必须是正整数")
