   10:     comps = {}
   10:     mapping = bytearray(256)
   10:     block = 0
   10:     data = bytearray()
 2570:     for i in range(0, 65536, 256):
 2560:         chunk = charmap[i: i + 256]
 2560:         if chunk in comps:
 2528:             mapping[i // 256] = comps[chunk]
               else:
   32:             mapping[i // 256] = comps[chunk] = block
   32:             block += 1
   32:             data += chunk
   10:     data = _mk_bitmap(data)
   10:     data[0:0] = [block] + _bytes_to_codes(mapping)
   10:     out.append((BIGCHARSET, data))
   10:     out += tail
   10:     return out, hascased
       
